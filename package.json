{
  "name": "seventh-color-js13-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "js13kGames 2026 build pipeline for The Seventh Color",
  "scripts": {
    "pull": "node tools/pull.mjs",
    "pack": "node tools/pack.mjs",
    "verify": "node tools/verify.mjs",
    "weigh": "node tools/weigh.mjs",
    "size": "npm run pull && npm run pack && npm run verify",
    "size:fast": "node tools/pack.mjs --no-roadroller",
    "probe": "node tools/probe.mjs",
    "native": "node tools/native.mjs",
    "native:verify": "node tools/verify-native.mjs",
    "native:soak": "node tools/verify-native.mjs 1 --soak=75",
    "native:dev": "node tools/native.mjs --no-roadroller --cheats",
    "native:coverage": "npm run native:dev && node tools/verify-native.mjs 1 --skipall",
    "strands": "node tools/native.mjs --game=strands",
    "strands:verify": "node tools/verify-native.mjs --game=strands",
    "strands:gate": "node tools/native.mjs --game=strands --O1 --rolls=5 && node tools/verify-native.mjs 3 --game=strands --keys=space,up:2500,left:400,up:1500",
    "native:gate": "node tools/check-puzzles.mjs && node tools/play-native.mjs && npm run native:coverage && node tools/native.mjs --O1 --rolls=5 && npm run native:verify && npm run native:soak"
  },
  "devDependencies": {
    "@gfx/zopfli": "1.0.15",
    "acorn": "^8.18.0",
    "esbuild": "0.24.2",
    "playwright-core": "1.56.1",
    "roadroller": "2.1.0",
    "terser": "5.50.0"
  }
}
